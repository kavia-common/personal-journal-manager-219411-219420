# Backend environment variables for development

# Comma-separated list of allowed origins for CORS.
# Example: ALLOWED_ORIGINS=http://localhost:3000,https://my-preview-host.example.com
# Defaults to "*" (allow all) if not set, for local/dev use only.
ALLOWED_ORIGINS=*

# Optional single frontend URL (legacy). If ALLOWED_ORIGINS is set, this is ignored.
# NG_APP_FRONTEND_URL=http://localhost:3000

# SQLite database filename (stored in the project root of journal_backend).
# Defaults to journal.db if not set.
# JOURNAL_DB_FILENAME=journal.db
